{
  "name": "mote-studio",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first character lab for expressive, animated SVG motes.",
  "license": "MIT",
  "author": "metaforismo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaforismo/mote-studio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "predev": "npm run build:core",
    "dev": "vite",
    "build": "npm run build:packages && tsc -b && vite build",
    "build:core": "npm run build --workspace @mote-studio/core",
    "build:mcp": "npm run build --workspace @mote-studio/mcp",
    "build:packages": "npm run build:core && npm run build:mcp",
    "lint": "oxlint",
    "pretest": "npm run build:packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:build": "npm run build:packages",
    "mcp:inspect": "npm run mcp:build && npx @modelcontextprotocol/inspector node packages/mcp/dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@mote-studio/core": "file:packages/core",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
